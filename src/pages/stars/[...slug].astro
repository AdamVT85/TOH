---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import StarGuideLayout from '../../layouts/StarGuideLayout.astro';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const guides = await reader.collections.starGuides.all();
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { slug: guide.slug },
  }));
}

const { slug } = Astro.props;
const reader = createReader(process.cwd(), keystaticConfig);
const guide = await reader.collections.starGuides.read(slug);
if (!guide) return Astro.redirect('/404');
---

<StarGuideLayout
  name={guide.name}
  nickname={guide.nickname}
  birthYear={guide.birthYear || undefined}
  deathYear={guide.deathYear || undefined}
  portraitImage={guide.portraitImage || undefined}
  heroImage={guide.heroImage || undefined}
  excerpt={guide.excerpt}
  keyFilms={guide.keyFilms}
  keyDestinations={guide.keyDestinations}
  sections={guide.sections}
/>
