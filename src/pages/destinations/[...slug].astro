---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import { resolveRelated } from '../../lib/related.js';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const destinations = await reader.collections.destinations.all();
  return destinations.map((dest) => ({
    params: { slug: dest.slug },
    props: { slug: dest.slug },
  }));
}

const { slug } = Astro.props;
const reader = createReader(process.cwd(), keystaticConfig);
const dest = await reader.collections.destinations.read(slug);
if (!dest) return Astro.redirect('/404');

const related = await resolveRelated(reader, {
  venues: dest.featuredVenues,
  stars: dest.relatedStars,
  articles: dest.relatedArticles,
});
---

<DestinationLayout
  title={dest.title}
  country={dest.country}
  region={dest.region}
  heroImage={dest.heroImage || undefined}
  heroImageAlt={dest.heroImageAlt}
  heroImageCredit={dest.heroImageCredit}
  excerpt={dest.excerpt}
  passportStamps={dest.passportStamps}
  sections={dest.sections}
>
  <RelatedCards slot="related" items={related} />
</DestinationLayout>
