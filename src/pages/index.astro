---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import ArticlesCarousel from '../components/ArticlesCarousel';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const allArticles = await reader.collections.articles.all();
const homepage = await reader.singletons.homepage.read();

const featuredArticles = allArticles
  .map(({ slug, entry }) => ({
    slug,
    title: entry.title,
    heroImage: entry.heroImage || undefined,
    excerpt: entry.excerpt,
    publishDate: entry.publishDate || undefined,
  }))
  .sort((a, b) => {
    if (!a.publishDate) return 1;
    if (!b.publishDate) return -1;
    return b.publishDate.localeCompare(a.publishDate);
  })
  .slice(0, 8);

const cardThemes = [
  { bgColor: 'bg-gradient-to-b from-[#5b9ebd] to-[#2a5c7a]', neonType: 'red' },
  { bgColor: 'bg-gradient-to-b from-[#e09b58] to-[#b8612b]', neonType: 'blue' },
  { bgColor: 'bg-gradient-to-b from-[#3a2861] to-[#1a1130]', neonType: 'orange' },
  { bgColor: 'bg-gradient-to-b from-[#8c3b61] to-[#4a1a30]', neonType: 'pink' },
  { bgColor: 'bg-gradient-to-b from-[#4a7c59] to-[#2a4a34]', neonType: 'green' },
  { bgColor: 'bg-gradient-to-b from-[#5c4a7c] to-[#2a1a4a]', neonType: 'purple' },
];

const featuredDestinations = (homepage?.featuredDestinations || [])
  .filter((card) => card.titleBottom && card.linkUrl)
  .map((card, i) => ({
    ...card,
    ...cardThemes[i % cardThemes.length],
  }));

const featuredStarSlugs = (homepage?.featuredStars || []).filter((s): s is string => !!s);
const featuredStars = (
  await Promise.all(
    featuredStarSlugs.map(async (slug) => {
      const star = await reader.collections.starGuides.read(slug);
      if (!star) return null;
      return {
        slug,
        name: star.name,
        portraitImage: star.portraitImage || undefined,
      };
    })
  )
).filter((s): s is NonNullable<typeof s> => s !== null && !!s.portraitImage);

const lastNameUpper = (name: string) => name.trim().split(/\s+/).pop()?.toUpperCase() ?? '';
---

<BaseLayout title="Travel Old Hollywood" description="Travel in the footsteps of the stars. A curated guide to the hotels, restaurants, and destinations of classic Hollywood.">
  <div class="min-h-screen bg-[#d8c5a5] p-2 md:p-8 font-sans flex justify-center items-center overflow-x-hidden">
    <!-- Main Poster Container -->
    <div class="relative w-full max-w-[1200px] border-[12px] md:border-[16px] border-[#e8d5b5] shadow-2xl overflow-hidden bg-gradient-to-b from-[#2b3a55] via-[#e8b05c] to-[#a32226] rounded-sm">

      <!-- Textures -->
      <div class="absolute inset-0 bg-noise mix-blend-overlay opacity-60 pointer-events-none z-50"></div>
      <div class="absolute inset-0 bg-halftone pointer-events-none z-40"></div>

      <!-- Hero Background Image (Clipped & Slanted) -->
      <div class="absolute top-[80px] md:top-[120px] left-0 w-full h-[500px] md:h-[700px] z-0" style="clip-path: polygon(0 15%, 100% 0, 100% 85%, 0 100%)">
        <img
          src="https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?q=80&w=2070&auto=format&fit=crop"
          class="w-full h-full object-cover filter contrast-125 saturate-150 sepia-[.3]"
          alt="Vintage Travel Background"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-[#a32226]/70 via-transparent to-[#2b3a55]/70 mix-blend-multiply"></div>
      </div>

      <!-- Content Container -->
      <div class="relative z-20 flex flex-col pt-8 md:pt-12 pb-6 md:pb-8 px-4 md:px-8">

        <!-- Header -->
        <div class="text-center flex flex-col items-center relative w-full">
          <h1 class="font-anton text-[13vw] md:text-[110px] text-[#f7d068] tracking-normal leading-none text-3d transform -rotate-2 z-10">
            OLD HOLLYWOOD
          </h1>
          <h2 class="font-cursive text-[22vw] md:text-[160px] text-[#fdfbf2] -mt-8 md:-mt-24 transform -rotate-[4deg] z-20 text-outline">
            <span class="relative z-[1]">T</span><span class="relative z-[2]">r</span><span class="relative z-[3]">a</span><span class="relative z-[4]">v</span><span class="relative z-[5]">e</span><span class="relative z-[6]">l</span>
          </h2>

          <div class="absolute right-0 md:right-[5%] top-[75%] md:top-[65%] font-oswald text-[#c13a3a] text-lg md:text-4xl lg:text-5xl font-bold tracking-widest transform -rotate-[6deg] text-right leading-tight uppercase" style="text-shadow: 2px 2px 0px #1a2b4c">
            <p>IN THE FOOTSTEPS</p>
            <p>OF THE STARS</p>
          </div>
        </div>

        <!-- Spacer for Hero Image -->
        <div class="h-[250px] sm:h-[350px] md:h-[450px] w-full"></div>

        <!-- Cards Section -->
        {featuredDestinations.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-6 lg:gap-8 mt-16 md:mt-12 px-4 md:px-0">
            {featuredDestinations.map((card) => (
              <a
                href={card.linkUrl}
                class={`group relative w-full flex flex-col p-4 md:p-5 border-[3px] border-[#1a2b4c] shadow-[8px_8px_0px_#1a2b4c] transform -skew-y-6 ${card.bgColor} transition-transform hover:-translate-y-2 hover:shadow-[12px_12px_0px_#1a2b4c] duration-300 no-underline`}
              >
                <div class="text-center mb-3">
                  {card.titleTop && (
                    <p class="font-oswald text-sm md:text-base text-[#fceeb5] tracking-widest uppercase">{card.titleTop}</p>
                  )}
                  <h3 class="font-anton text-4xl md:text-5xl text-[#fceeb5] tracking-wide uppercase leading-none mt-1" style="text-shadow: 2px 2px 0 #1a2b4c, 3px 3px 0 #1a2b4c">
                    {card.titleBottom}
                  </h3>
                </div>
                <div class="w-full h-40 md:h-48 border-[3px] border-[#1a2b4c] mb-4 overflow-hidden bg-white relative">
                  <div class="absolute inset-0 bg-orange-900/20 mix-blend-multiply z-10 pointer-events-none"></div>
                  {card.image && (
                    <img src={card.image} alt={card.titleBottom} class="w-full h-full object-cover filter contrast-125 saturate-150 sepia-[.3]" />
                  )}
                </div>
                {card.text && (
                  <p class="font-sans text-[11px] md:text-xs text-center text-[#fceeb5] mb-6 px-1 md:px-2 leading-relaxed opacity-90">
                    {card.text}
                  </p>
                )}
                <div class="mt-auto flex justify-center pb-2">
                  <span class={`relative inline-block px-6 md:px-8 py-2 rounded-lg font-oswald text-lg md:text-xl tracking-widest bg-[#222] border-2 border-[#111] overflow-hidden neon-box-${card.neonType}`}>
                    <span class={`relative z-10 neon-text-${card.neonType}`}>{card.ctaText || 'BOOK NOW'}</span>
                    <span class="absolute inset-0 bg-black opacity-0 group-hover:opacity-30 transition-opacity"></span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

        <!-- Featured Articles -->
        <div class="relative z-20 w-[105%] -ml-[2.5%]">
          <ArticlesCarousel client:visible articles={featuredArticles} />
        </div>

        <!-- Newsletter Ticket -->
        <div class="my-24 px-4 md:px-8 relative z-20">
          <div class="w-full max-w-4xl mx-auto bg-[#f4e4bc] border-[3px] border-[#1a2b4c] flex flex-col md:flex-row relative shadow-[12px_12px_0px_#1a2b4c] transform rotate-1">
            <div class="absolute inset-1 border border-[#1a2b4c] pointer-events-none"></div>

            <div class="flex-1 p-6 md:p-10 border-b-4 md:border-b-0 md:border-r-4 border-dashed border-[#1a2b4c] relative">
              <div class="flex justify-between items-start mb-6">
                <h4 class="font-oswald text-3xl md:text-4xl font-bold text-[#1a2b4c] uppercase tracking-widest">Boarding Pass</h4>
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1a2b4c] opacity-50"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
              </div>
              <p class="font-typewriter text-lg md:text-xl text-[#1a2b4c] mb-8 leading-relaxed">
                CLASSIC HOLLYWOOD TRAVEL, DELIVERED TO YOUR INBOX. STOP. <br/>
                NO SPAM, ONLY GLAMOUR. STOP.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1 relative">
                  <span class="absolute -top-3 left-2 bg-[#f4e4bc] px-1 font-typewriter text-xs text-[#1a2b4c] font-bold">TELEGRAPHIC ADDRESS</span>
                  <input type="email" placeholder="Email Address" class="w-full bg-transparent border-2 border-[#1a2b4c] font-typewriter text-[#1a2b4c] placeholder-[#1a2b4c]/40 focus:outline-none p-3 text-lg" />
                </div>
              </div>
            </div>

            <div class="w-full md:w-64 bg-[#c13a3a] p-6 md:p-8 flex flex-col items-center justify-center cursor-pointer hover:bg-[#a32226] transition-colors relative group">
              <div class="absolute inset-1 border border-[#fceeb5] pointer-events-none opacity-50"></div>
              <div class="w-12 h-12 rounded-full border-2 border-[#fceeb5] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <div class="w-8 h-8 rounded-full bg-[#fceeb5]"></div>
              </div>
              <span class="font-oswald text-2xl md:text-3xl text-[#fceeb5] tracking-widest uppercase text-center leading-none">
                Punch<br/>Ticket
              </span>
              <span class="font-typewriter text-xs text-[#fceeb5] mt-4 opacity-70">ADMIT ONE</span>
            </div>
          </div>
        </div>

        <!-- Travel by Star -->
        <div class="my-16 px-4 md:px-8 relative z-20">
          <div class="text-center mb-12">
            <h3 class="font-anton text-7xl md:text-8xl text-[#fceeb5] tracking-wide uppercase text-3d transform -rotate-2">
              Travel by Star
            </h3>
            <p class="font-cursive text-5xl md:text-6xl text-[#fdfbf2] mt-2 transform -rotate-2" style="-webkit-text-stroke: 1px #1a2b4c; text-shadow: 2px 2px 0px #1a2b4c">
              Follow in their footsteps
            </p>
          </div>

          {featuredStars.length > 0 && (
            <div class="flex flex-wrap justify-center gap-6 md:gap-10">
              {featuredStars.map((star) => (
                <a href={`/stars/${star.slug}`} class="flex flex-col items-center group cursor-pointer transform transition-transform hover:-translate-y-2">
                  <div class="w-24 h-32 md:w-32 md:h-40 rounded-full border-[4px] border-[#d4b872] shadow-[0_0_15px_rgba(212,184,114,0.6)] overflow-hidden mb-4 relative bg-[#1a2b4c]">
                    <div class="absolute inset-0 border-[3px] border-[#8a6d3b] rounded-full z-10 pointer-events-none"></div>
                    <img src={star.portraitImage} alt={star.name} class="w-full h-full object-cover grayscale contrast-125 sepia-[.2] group-hover:scale-110 transition-transform duration-700" />
                  </div>
                  <span class="font-oswald text-lg md:text-xl text-[#fceeb5] tracking-widest uppercase bg-[#1a2b4c] px-4 py-1 border-2 border-[#d4b872] shadow-[4px_4px_0px_rgba(0,0,0,0.5)]">
                    {lastNameUpper(star.name)}
                  </span>
                </a>
              ))}
            </div>
          )}

          <div class="mt-12 text-center">
            <a href="/directory" class="inline-block border-2 border-[#fceeb5] px-8 py-3 font-oswald text-lg tracking-[0.2em] text-[#fceeb5] hover:bg-[#fceeb5] hover:text-[#1a2b4c] transition-colors uppercase">
              View Full Film & Star Index
            </a>
          </div>
        </div>

        <!-- Latest Articles Grid -->
        <div class="my-24 px-4 md:px-8 relative z-20">
          <div class="text-center mb-16">
            <h3 class="font-anton text-5xl md:text-6xl text-[#fceeb5] tracking-wide uppercase text-3d transform rotate-1">
              Latest Dispatches
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-6">
            {[
              { title: "A Weekend in Havana", date: "OCT 14, 1954", img: "https://images.unsplash.com/photo-1508154048109-ee451cbbfb6a?q=80&w=600&auto=format&fit=crop", rot: "-rotate-2" },
              { title: "The Orient Express", date: "NOV 02, 1938", img: "https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?q=80&w=600&auto=format&fit=crop", rot: "rotate-3" },
              { title: "Roman Holiday", date: "SEP 28, 1953", img: "https://images.unsplash.com/photo-1552832230-c0197dd311b5?q=80&w=600&auto=format&fit=crop", rot: "-rotate-1" },
              { title: "Escape to the Alps", date: "DEC 12, 1961", img: "https://images.unsplash.com/photo-1486870591958-9b9d0d1dda99?q=80&w=600&auto=format&fit=crop", rot: "rotate-2" },
            ].map((article) => (
              <a href="/directory" class={`block bg-[#fdfbf2] p-3 md:p-4 shadow-[8px_8px_15px_rgba(0,0,0,0.4)] transform ${article.rot} hover:rotate-0 hover:scale-105 transition-all duration-300 border border-[#d8c5a5] relative group`}>
                <!-- Tape -->
                <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 w-16 h-6 bg-white/40 backdrop-blur-sm border border-white/20 shadow-sm rotate-1 z-20"></div>

                <!-- Stamp & Postmark -->
                <div class="absolute top-6 right-6 z-10 opacity-90 group-hover:opacity-100 transition-opacity">
                  <div class="w-10 h-12 border-[3px] border-dotted border-[#a32226] p-0.5 bg-[#f4e4bc] transform rotate-6 shadow-sm">
                    <div class="w-full h-full bg-[#2b3a55]/10 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#a32226] transform -rotate-45"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                    </div>
                  </div>
                  <div class="postmark -top-4 -right-4"></div>
                </div>

                <div class="w-full h-48 overflow-hidden mb-4 border-2 border-[#e8d5b5]">
                  <img src={article.img} alt={article.title} class="w-full h-full object-cover filter sepia-[.4] contrast-125 group-hover:scale-110 transition-transform duration-700" />
                </div>

                <h4 class="font-handwriting text-3xl md:text-4xl text-[#1a2b4c] leading-tight mb-1 px-2">{article.title}</h4>
                <p class="font-typewriter text-xs text-[#a32226] px-2 pb-2 font-bold tracking-widest">{article.date}</p>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Footer -->
      <Footer />

    </div>
  </div>
</BaseLayout>
