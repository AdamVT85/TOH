---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import VintageMap from '../components/VintageMap';

interface Props {
  name: string;
  nickname?: string;
  birthYear?: number;
  deathYear?: number;
  portraitImage?: string;
  heroImage?: string;
  excerpt?: string;
  keyFilms?: { title: string; year?: string }[];
  keyDestinations?: string[];
}

const props = Astro.props;
---

<BaseLayout title={`The Ultimate ${props.name} Travel Guide`} description={props.excerpt} image={props.portraitImage || undefined} type="article">
  <div class="min-h-screen bg-[#d8c5a5] text-[#1a2b4c] p-2 md:p-8 font-sans" style="background-image: url('https://www.transparenttextures.com/patterns/aged-paper.png')">
    <div class="max-w-6xl mx-auto border-[12px] border-double border-[#1a2b4c] bg-[#fdfbf2] shadow-2xl relative overflow-hidden">

      <!-- Texture Overlays -->
      <div class="absolute inset-0 bg-noise mix-blend-overlay opacity-60 pointer-events-none z-50"></div>
      <div class="absolute inset-0 bg-halftone pointer-events-none z-40"></div>

      <Header backLink="/directory" backLabel="Return to Index" variant="dark" />

      <!-- Hero Section -->
      <div class="relative w-full flex flex-col md:flex-row min-h-[600px] overflow-hidden">
        <!-- Portrait Left -->
        <div class="w-full md:w-[40%] h-[50vh] md:h-auto relative group">
          {props.portraitImage && (
            <img src={props.portraitImage} alt={props.name} class="w-full h-full object-cover filter grayscale contrast-125 group-hover:sepia-[.4] transition-all duration-700" />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4c]/80 to-transparent md:hidden"></div>
        </div>

        <!-- Name Right -->
        <div class="w-full md:w-[60%] bg-gradient-to-br from-[#1a2b4c] via-[#2b3a55] to-[#a32226] p-8 md:p-16 flex flex-col justify-center relative">
          <div class="relative z-10 transform -rotate-2">
            <h1 class="font-anton text-[#fceeb5] uppercase text-3d leading-[0.8] flex flex-col">
              <span class="text-6xl md:text-8xl tracking-wider">{props.name.split(' ')[0]?.toUpperCase()}</span>
              <span class="text-7xl md:text-[140px] tracking-tight -ml-2">{props.name.split(' ').slice(1).join(' ').toUpperCase()}</span>
            </h1>
            {props.nickname && (
              <p class="font-cursive text-3xl md:text-5xl text-[#fdfbf2] mt-4 ml-4" style="-webkit-text-stroke: 1px #1a2b4c; text-shadow: 2px 2px 0px #1a2b4c">
                "{props.nickname}"
              </p>
            )}
            {(props.birthYear || props.deathYear) && (
              <div class="mt-8 ml-4 font-typewriter text-[#d4b872] tracking-[0.3em] text-sm md:text-base border-t border-[#d4b872]/30 pt-4 inline-block">
                {props.birthYear} — {props.deathYear}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Dossier Header Strip -->
      {props.keyDestinations && props.keyDestinations.length > 0 && (
        <div class="bg-[#e8dcb8] border-b-4 border-[#8b5a2b] py-4 px-6 relative overflow-hidden">
          <div class="flex flex-wrap items-center gap-y-4 text-sm md:text-base font-typewriter uppercase text-[#1a2b4c] max-w-5xl mx-auto relative z-10">
            {props.birthYear && (
              <div class="flex items-center">
                <span class="font-bold mr-2 text-[#8b5a2b]">BORN:</span> {props.birthYear}
              </div>
            )}
            {props.deathYear && (
              <>
                <div class="hidden md:block w-px h-6 bg-[#d4b872] mx-6"></div>
                <div class="flex items-center">
                  <span class="font-bold mr-2 text-[#8b5a2b]">DIED:</span> {props.deathYear}
                </div>
              </>
            )}
            <div class="hidden lg:block w-px h-6 bg-[#d4b872] mx-6"></div>
            <div class="flex items-center gap-2 mt-2 lg:mt-0 w-full lg:w-auto">
              <span class="font-bold mr-2 text-[#8b5a2b]">KEY DESTINATIONS:</span>
              {props.keyDestinations.map((dest) => (
                <span class="bg-[#fdfbf2] border border-[#8b5a2b] px-2 py-0.5 text-xs shadow-sm">{dest}</span>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- Editorial Body -->
      <div class="p-8 md:p-16 max-w-4xl mx-auto">
        <div class="font-sans text-lg leading-relaxed text-[#222] space-y-6
          prose prose-lg max-w-none
          prose-headings:font-oswald prose-headings:text-[#1a2b4c] prose-headings:uppercase prose-headings:tracking-widest
          prose-a:text-[#c13a3a] prose-a:hover:underline prose-a:decoration-[#d4b872]
          prose-blockquote:border-l-4 prose-blockquote:border-[#c13a3a] prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:font-serif prose-blockquote:text-2xl
        ">
          <slot />
        </div>
      </div>

      <!-- Travel Map -->
      <div class="py-16 px-4 md:px-8 bg-[#1a2b4c] relative border-y-[6px] border-[#d4b872]">
        <div class="text-center mb-12">
          <h2 class="font-anton text-4xl md:text-5xl text-[#fceeb5] uppercase tracking-widest text-3d transform -rotate-1">
            THE WORLD OF {props.name.toUpperCase()}
          </h2>
        </div>
        <div class="max-w-5xl mx-auto">
          <VintageMap client:visible />
        </div>
      </div>

      <!-- Key Films -->
      {props.keyFilms && props.keyFilms.length > 0 && (
        <div class="bg-[#1a2b4c] relative py-16 px-4 md:px-8 lg:px-12 border-y-[8px] border-double border-[#d4b872]">
          <div class="absolute top-0 left-0 right-0 h-4 bg-[#1a2b4c]" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 10px, #fdfbf2 10px, #fdfbf2 20px); background-size: 30px 100%; background-position: center; opacity: 0.8"></div>
          <div class="absolute bottom-0 left-0 right-0 h-4 bg-[#1a2b4c]" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 10px, #fdfbf2 10px, #fdfbf2 20px); background-size: 30px 100%; background-position: center; opacity: 0.8"></div>

          <h2 class="font-anton text-3xl md:text-4xl text-[#d4b872] uppercase tracking-widest text-center mb-12">&#9733; ESSENTIAL VIEWING &#9733;</h2>

          <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-6xl mx-auto">
            {props.keyFilms.map((film) => (
              <div class="group cursor-pointer transform hover:scale-105 transition-transform duration-300 flex flex-col items-center text-center">
                <div class="aspect-[2/3] w-full border-2 border-[#d4b872] mb-3 bg-gradient-to-br from-[#2a4a7a] to-[#1a2b4c] flex items-center justify-center relative overflow-hidden shadow-[4px_4px_0px_rgba(0,0,0,0.5)] group-hover:border-[#fceeb5] transition-colors">
                  <div class="absolute inset-0 opacity-20" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png')"></div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#d4b872] opacity-30"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                </div>
                <h3 class="font-oswald text-[#fdfbf2] uppercase tracking-wider text-sm leading-tight mb-1 group-hover:text-[#d4b872] transition-colors">{film.title}</h3>
                {film.year && <p class="font-typewriter text-[#d4b872] text-[10px]">{film.year}</p>}
              </div>
            ))}
          </div>
        </div>
      )}

      <Footer />
    </div>
  </div>
</BaseLayout>
