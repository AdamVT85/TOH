---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Section {
  heading?: string;
  image?: string;
  imageAlt?: string;
  caption?: string;
  copy?: string;
  callout?: string;
}

interface Props {
  name: string;
  nickname?: string;
  birthYear?: number;
  deathYear?: number;
  portraitImage?: string;
  portraitFocus?: string;
  heroImage?: string;
  excerpt?: string;
  keyFilms?: { title: string; year?: string }[];
  keyDestinations?: string[];
  sections?: Section[];
  regions?: {
    region?: string;
    intro?: string;
    image?: string;
    imageAlt?: string;
    imageFocus?: string;
    caption?: string;
    places?: { name?: string; category?: string; venueSlug?: string; description?: string; detail?: string; status?: string }[];
  }[];
  lifestyle?: { label?: string; text?: string }[];
}

const props = Astro.props;
const sections = props.sections || [];
---

<BaseLayout title={`The Ultimate ${props.name} Travel Guide`} description={props.excerpt} image={props.portraitImage || undefined} type="article">
  <div class="min-h-screen bg-[#d8c5a5] text-[#1a2b4c] p-2 md:p-8 font-sans" style="background-image: url('https://www.transparenttextures.com/patterns/aged-paper.png')">
    <div class="max-w-6xl mx-auto border-[12px] border-double border-[#1a2b4c] bg-[#fdfbf2] shadow-2xl relative overflow-hidden">

      <!-- Texture Overlays -->
      <div class="absolute inset-0 bg-noise mix-blend-overlay opacity-60 pointer-events-none z-50"></div>
      <div class="absolute inset-0 bg-halftone pointer-events-none z-40"></div>

      <Header backLink="/directory" backLabel="Return to Index" variant="dark" />

      <!-- Hero Section -->
      <div class="relative w-full flex flex-col md:flex-row min-h-[600px] overflow-hidden">
        <!-- Portrait Left -->
        <div class="w-full md:w-[40%] h-[50vh] md:h-auto relative group">
          {props.portraitImage && (
            <img src={props.portraitImage} alt={props.name} class="w-full h-full object-cover filter grayscale contrast-125 group-hover:sepia-[.4] transition-all duration-700" style={`object-position: ${props.portraitFocus || 'top'}`} />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4c]/80 to-transparent md:hidden"></div>
        </div>

        <!-- Name Right -->
        <div class="w-full md:w-[60%] bg-gradient-to-br from-[#1a2b4c] via-[#2b3a55] to-[#a32226] p-8 md:p-16 flex flex-col justify-center relative">
          {props.heroImage && (
            <img src={props.heroImage} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-luminosity" />
          )}
          <div class="relative z-10 transform -rotate-2">
            <h1 class="font-anton text-[#fceeb5] uppercase text-3d leading-[0.8] flex flex-col">
              <span class="text-6xl md:text-8xl tracking-wider">{props.name.split(' ')[0]?.toUpperCase()}</span>
              <span class="text-7xl md:text-[140px] tracking-tight -ml-2">{props.name.split(' ').slice(1).join(' ').toUpperCase()}</span>
            </h1>
            {props.nickname && (
              <p class="font-cursive text-3xl md:text-5xl text-[#fdfbf2] mt-4 ml-4" style="-webkit-text-stroke: 1px #1a2b4c; text-shadow: 2px 2px 0px #1a2b4c">
                "{props.nickname}"
              </p>
            )}
            {(props.birthYear || props.deathYear) && (
              <div class="mt-8 ml-4 font-typewriter text-[#d4b872] tracking-[0.3em] text-sm md:text-base border-t border-[#d4b872]/30 pt-4 inline-block">
                {props.birthYear} — {props.deathYear}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Dossier Header Strip -->
      {props.keyDestinations && props.keyDestinations.length > 0 && (
        <div class="bg-[#e8dcb8] border-b-4 border-[#8b5a2b] py-4 px-6 relative overflow-hidden">
          <div class="flex flex-wrap items-center gap-y-4 text-sm md:text-base font-typewriter uppercase text-[#1a2b4c] max-w-5xl mx-auto relative z-10">
            {props.birthYear && (
              <div class="flex items-center">
                <span class="font-bold mr-2 text-[#8b5a2b]">BORN:</span> {props.birthYear}
              </div>
            )}
            {props.deathYear && (
              <>
                <div class="hidden md:block w-px h-6 bg-[#d4b872] mx-6"></div>
                <div class="flex items-center">
                  <span class="font-bold mr-2 text-[#8b5a2b]">DIED:</span> {props.deathYear}
                </div>
              </>
            )}
            <div class="hidden lg:block w-px h-6 bg-[#d4b872] mx-6"></div>
            <div class="flex items-center gap-2 mt-2 lg:mt-0 w-full lg:w-auto">
              <span class="font-bold mr-2 text-[#8b5a2b]">KEY DESTINATIONS:</span>
              {props.keyDestinations.map((dest) => (
                <span class="bg-[#fdfbf2] border border-[#8b5a2b] px-2 py-0.5 text-xs shadow-sm">{dest}</span>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- Editorial Body -->
      <div class="p-8 md:p-16 max-w-4xl mx-auto">
        <div class="font-sans text-lg leading-relaxed text-[#222]">
          {sections.map((section, i) => (
            <div class="mb-12">
              {section.heading && (
                <h2 class="font-oswald text-3xl text-[#1a2b4c] uppercase tracking-widest mb-4 border-b-2 border-dotted border-[#d4b872] pb-2">
                  {section.heading}
                </h2>
              )}

              {section.image && (
                <figure class={`my-6 p-2 bg-[#fdfbf2] border border-[#d4b872] shadow-[4px_4px_0px_rgba(212,184,114,0.4)] ${i % 2 === 0 ? 'transform -rotate-1' : 'transform rotate-1'} flow-root`}>
                  <img src={section.image} alt={section.imageAlt || section.heading} class="w-full h-64 md:h-96 object-cover filter contrast-125 sepia-[.3]" />
                  {section.caption && (
                    <figcaption class="text-center font-typewriter text-xs text-[#8b5a2b] mt-3 mb-1 uppercase tracking-widest">{section.caption}</figcaption>
                  )}
                </figure>
              )}

              {section.copy && section.copy.split('\n\n').map((para) => (
                <p class="mb-4" set:html={para} />
              ))}

              {section.callout && (
                <blockquote class="my-10 border-l-4 border-[#c13a3a] pl-6 py-4 bg-[#f4e4bc]/50 italic font-serif text-2xl text-[#8b5a2b] relative shadow-sm flow-root">
                  <span class="absolute -top-6 -left-4 font-anton text-8xl text-[#c13a3a] opacity-20">"</span>
                  {section.callout}
                </blockquote>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- The Trail: regions -> places -->
      {props.regions && props.regions.length > 0 && (
        <div class="bg-[#fdfbf2] border-t-4 border-double border-[#1a2b4c]">
          <div class="max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-16">
            <h2 class="font-anton text-4xl md:text-5xl text-[#1a2b4c] uppercase tracking-widest">The Trail</h2>
            <p class="font-cursive text-2xl md:text-3xl text-[#c13a3a] mb-12">Where to walk in his footsteps</p>

            {props.regions.map((region) => (
              <section class="mb-16">
                {region.region && (
                  <h3 class="font-oswald text-2xl md:text-3xl text-[#c13a3a] uppercase tracking-widest border-b-2 border-[#d4b872] pb-2 mb-5">{region.region}</h3>
                )}
                {region.intro && region.intro.split('\n\n').map((para) => (
                  <p class="mb-4 text-[#222] leading-relaxed" set:html={para} />
                ))}
                {region.image && (
                  <figure class="my-6 p-2 bg-[#fdfbf2] border border-[#d4b872] shadow-[4px_4px_0px_rgba(212,184,114,0.4)] flow-root">
                    <img src={region.image} alt={region.imageAlt || region.region} class="w-full h-64 md:h-80 object-cover filter contrast-125 sepia-[.3]" style={`object-position: ${region.imageFocus || 'center'}`} />
                    {region.caption && (
                      <figcaption class="text-center font-typewriter text-xs text-[#8b5a2b] mt-3 uppercase tracking-widest">{region.caption}</figcaption>
                    )}
                  </figure>
                )}
                {region.places && region.places.length > 0 && (
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6">
                    {region.places.map((place) => {
                      const closed = place.status && place.status !== 'Open';
                      return (
                        <div class="bg-white border border-[#e8d5b5] p-5 shadow-sm hover:shadow-md transition-shadow">
                          <div class="flex flex-wrap items-center gap-2 mb-2">
                            {place.category && (
                              <span class="font-oswald text-[10px] tracking-widest uppercase bg-[#1a2b4c] text-[#fceeb5] px-2 py-0.5">{place.category}</span>
                            )}
                            {closed && (
                              <span class="font-oswald text-[10px] tracking-widest uppercase bg-[#8b2b2b] text-[#fceeb5] px-2 py-0.5">{place.status}</span>
                            )}
                          </div>
                          <h4 class="font-serif text-2xl text-[#1a2b4c] leading-tight mb-2">
                            {place.venueSlug ? (
                              <a href={`/venues/${place.venueSlug}`} class="hover:text-[#c13a3a] transition-colors underline decoration-[#d4b872] underline-offset-4">{place.name}</a>
                            ) : (
                              place.name
                            )}
                          </h4>
                          {place.description && (
                            <p class="font-sans text-sm text-[#2b3a55] mb-3" set:html={place.description} />
                          )}
                          {place.detail && (
                            <p class="font-typewriter text-xs text-[#8b5a2b] border-t border-[#e8d5b5] pt-2">{place.detail}</p>
                          )}
                        </div>
                      );
                    })}
                  </div>
                )}
              </section>
            ))}
          </div>
        </div>
      )}

      <!-- Live Like… -->
      {props.lifestyle && props.lifestyle.length > 0 && (
        <div class="bg-[#1a2b4c] py-16 px-6 md:px-12 border-t-[8px] border-double border-[#d4b872]">
          <div class="max-w-5xl mx-auto">
            <h2 class="font-anton text-3xl md:text-4xl text-[#d4b872] uppercase tracking-widest text-center mb-12">Live Like {props.name.split(' ')[0]}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
              {props.lifestyle.map((item) => (
                <div class="border-l-4 border-[#c13a3a] pl-5">
                  {item.label && <h3 class="font-oswald text-xl text-[#fceeb5] uppercase tracking-wider mb-2">{item.label}</h3>}
                  {item.text && item.text.split('\n\n').map((para) => (
                    <p class="font-sans text-sm text-[#d8c5a5] mb-3 leading-relaxed" set:html={para} />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- Key Films -->
      {props.keyFilms && props.keyFilms.length > 0 && (
        <div class="bg-[#1a2b4c] relative py-16 px-4 md:px-8 lg:px-12 border-y-[8px] border-double border-[#d4b872]">
          <div class="absolute top-0 left-0 right-0 h-4 bg-[#1a2b4c]" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 10px, #fdfbf2 10px, #fdfbf2 20px); background-size: 30px 100%; background-position: center; opacity: 0.8"></div>
          <div class="absolute bottom-0 left-0 right-0 h-4 bg-[#1a2b4c]" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 10px, #fdfbf2 10px, #fdfbf2 20px); background-size: 30px 100%; background-position: center; opacity: 0.8"></div>

          <h2 class="font-anton text-3xl md:text-4xl text-[#d4b872] uppercase tracking-widest text-center mb-12">&#9733; ESSENTIAL VIEWING &#9733;</h2>

          <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-6xl mx-auto">
            {props.keyFilms.map((film) => (
              <div class="group cursor-pointer transform hover:scale-105 transition-transform duration-300 flex flex-col items-center text-center">
                <div class="aspect-[2/3] w-full border-2 border-[#d4b872] mb-3 bg-gradient-to-br from-[#2a4a7a] to-[#1a2b4c] flex items-center justify-center relative overflow-hidden shadow-[4px_4px_0px_rgba(0,0,0,0.5)] group-hover:border-[#fceeb5] transition-colors">
                  <div class="absolute inset-0 opacity-20" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png')"></div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#d4b872] opacity-30"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                </div>
                <h3 class="font-oswald text-[#fdfbf2] uppercase tracking-wider text-sm leading-tight mb-1 group-hover:text-[#d4b872] transition-colors">{film.title}</h3>
                {film.year && <p class="font-typewriter text-[#d4b872] text-[10px]">{film.year}</p>}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Keep Exploring -->
      <div class="bg-[#1a2b4c] p-8 md:p-16 border-t-[8px] border-double border-[#d4b872]">
        <h3 class="font-anton text-4xl md:text-5xl text-[#fceeb5] tracking-widest uppercase text-center mb-12">Keep Exploring</h3>
        <slot name="related" />
      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>
