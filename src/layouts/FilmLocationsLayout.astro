---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RichText from '../components/RichText.astro';
import { hasRichText } from '../lib/richtext.js';

type RichValue = { node: any } | null;

interface Location {
  name: string;
  locationType: string;
  filmContext?: RichValue;
  image?: string;
  imageCaption?: string;
  visitStatus?: string;
  address?: string;
  openingHours?: string;
  cost?: string;
  tips?: RichValue;
  venueSlug?: string;
}

interface Props {
  filmTitle: string;
  subtitle?: string;
  year?: string;
  director?: string;
  stars?: string;
  primaryLocations?: string;
  heroImage?: string;
  heroImageAlt?: string;
  excerpt?: string;
  locations?: Location[];
  whereToStay?: { name: string; description?: string; price?: string; venueSlug?: string; image?: string }[];
}

const props = Astro.props;
---

<BaseLayout title={`${props.filmTitle} Filming Locations`} description={props.excerpt} image={props.heroImage || undefined} type="article">
  <div class="min-h-screen bg-[#d8c5a5] text-[#1a2b4c] p-2 md:p-8 font-sans" style="background-image: url('https://www.transparenttextures.com/patterns/aged-paper.png')">
    <div class="max-w-6xl mx-auto border-[12px] border-double border-[#1a2b4c] bg-[#fdfbf2] shadow-2xl relative overflow-hidden">

      <!-- Texture Overlays -->
      <div class="absolute inset-0 bg-noise mix-blend-overlay opacity-60 pointer-events-none z-50"></div>
      <div class="absolute inset-0 bg-halftone pointer-events-none z-40"></div>

      <Header backLink="/directory" backLabel="Return to Index" variant="dark" />

      <!-- Hero Section -->
      <div class="relative w-full h-[60vh] md:h-[80vh] overflow-hidden flex flex-col justify-end pb-16 px-8 md:px-16">
        <div class="absolute inset-0 z-0">
          {props.heroImage && (
            <img src={props.heroImage} alt={props.heroImageAlt || props.filmTitle} class="w-full h-full object-cover filter contrast-125 sepia-[.3]" />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4c] via-[#1a2b4c]/60 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl">
          <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-[#fceeb5] leading-none mb-4 drop-shadow-lg">
            {props.filmTitle}
          </h1>
          {props.subtitle && (
            <p class="font-oswald text-xl md:text-3xl text-white tracking-wide mb-6 drop-shadow-md">
              {props.subtitle}
            </p>
          )}
          <div class="font-typewriter text-[#d4b872] tracking-widest text-sm md:text-base border-t border-[#d4b872]/50 pt-4 inline-block">
            {props.year && `${props.year} · `}{props.director && `DIRECTED BY ${props.director.toUpperCase()}`}{props.stars && ` · STARRING ${props.stars.toUpperCase()}`}
          </div>
        </div>
      </div>

      <!-- Introduction -->
      <div class="p-8 md:p-16 max-w-5xl mx-auto flex flex-col md:flex-row gap-12">
        <div class="md:w-2/3 font-sans text-lg leading-relaxed text-[#222] space-y-6
          prose prose-lg max-w-none
          prose-a:text-[#c13a3a] prose-a:hover:underline prose-a:decoration-[#d4b872]
        ">
          <slot />
        </div>

        <!-- Quick-reference sidebar -->
        <div class="md:w-1/3">
          <div class="bg-[#e8dcb8] border-2 border-[#8b5a2b] p-6 shadow-[6px_6px_0px_rgba(139,90,43,0.2)] transform rotate-1">
            <h3 class="font-oswald uppercase tracking-widest text-[#1a2b4c] text-xl mb-4 border-b-2 border-[#8b5a2b] pb-2">Dossier</h3>
            <ul class="space-y-4 font-sans text-sm text-[#222]">
              {props.director && <li><strong class="font-oswald uppercase tracking-wider text-[#8b5a2b] block text-xs">Director</strong> {props.director}</li>}
              {props.stars && <li><strong class="font-oswald uppercase tracking-wider text-[#8b5a2b] block text-xs">Stars</strong> {props.stars}</li>}
              {props.year && <li><strong class="font-oswald uppercase tracking-wider text-[#8b5a2b] block text-xs">Year</strong> {props.year}</li>}
              {props.primaryLocations && <li><strong class="font-oswald uppercase tracking-wider text-[#8b5a2b] block text-xs">Locations</strong> {props.primaryLocations}</li>}
            </ul>
          </div>
        </div>
      </div>

      <!-- Location Sections -->
      {props.locations && props.locations.length > 0 && (
        <div class="max-w-5xl mx-auto px-4 md:px-16 py-8">
          {props.locations.map((loc, index) => (
            <div class="mb-24 relative">
              {index > 0 && <div class="w-full h-px bg-gradient-to-r from-transparent via-[#d4b872] to-transparent mb-16"></div>}

              <div class={`flex flex-col ${index % 2 !== 0 ? 'md:flex-row-reverse' : 'md:flex-row'} gap-8 md:gap-12 items-start`}>
                <!-- Image Side -->
                <div class="w-full md:w-1/2 relative group">
                  <div class="absolute inset-0 bg-[#d4b872] transform translate-x-3 translate-y-3 z-0"></div>
                  <div class="relative z-10 border-4 border-white overflow-hidden bg-white">
                    {loc.image && (
                      <img src={loc.image} alt={loc.name} class="w-full h-64 md:h-80 object-cover filter sepia-[.2] contrast-110 group-hover:scale-105 transition-transform duration-700" />
                    )}
                  </div>
                  <p class="font-typewriter text-[10px] text-gray-500 mt-4 text-right uppercase tracking-widest">Fig {index + 1}. {loc.name}</p>
                </div>

                <!-- Content Side -->
                <div class="w-full md:w-1/2 flex flex-col">
                  <div class="mb-4 flex items-center flex-wrap gap-3">
                    <h2 class="font-serif text-3xl md:text-4xl text-[#1a2b4c] leading-tight">{loc.name}</h2>
                    <span class="inline-block bg-[#1a2b4c] text-[#fceeb5] font-oswald uppercase tracking-widest text-[10px] px-3 py-1 rounded-full whitespace-nowrap">
                      {loc.locationType}
                    </span>
                  </div>

                  <RichText content={loc.filmContext} class="font-sans text-lg text-gray-800 mb-8 leading-relaxed [&_p:last-child]:mb-0" />

                  <!-- Visit Today Box -->
                  <div class="bg-[#f4e4bc]/50 border-l-4 border-[#c13a3a] p-6 mt-auto">
                    <h4 class="font-oswald uppercase tracking-widest text-[#1a2b4c] text-sm mb-4 flex items-center gap-2">Visit Today</h4>
                    <ul class="space-y-3 font-sans text-sm text-gray-700">
                      {loc.address && <li><strong>Location:</strong> {loc.address}</li>}
                      {loc.visitStatus && <li><strong>Status:</strong> {loc.visitStatus}</li>}
                      {loc.openingHours && <li><strong>Hours:</strong> {loc.openingHours}</li>}
                      {loc.cost && <li><strong>Cost:</strong> {loc.cost}</li>}
                      {hasRichText(loc.tips) && <li class="mt-2 pt-2 border-t border-[#8b5a2b]/20 italic"><RichText inline content={loc.tips} /></li>}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Where to Stay -->
      {props.whereToStay && props.whereToStay.length > 0 && (
        <div class="p-8 md:p-16 max-w-5xl mx-auto">
          <h2 class="font-anton text-4xl md:text-5xl text-[#1a2b4c] uppercase tracking-widest mb-12 text-center border-b-4 border-double border-[#1a2b4c] pb-4 inline-block mx-auto w-full">Where to Stay</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {props.whereToStay.map((hotel) => (
              <div class="bg-white border-2 border-[#8b5a2b] shadow-[6px_6px_0px_rgba(139,90,43,0.2)] flex flex-col sm:flex-row group hover:-translate-y-1 transition-transform duration-300">
                {hotel.image && (
                  <div class="w-full sm:w-2/5 h-48 sm:h-auto border-b-2 sm:border-b-0 sm:border-r-2 border-[#8b5a2b] overflow-hidden">
                    <a href={hotel.venueSlug ? `/venues/${hotel.venueSlug}` : '#'}>
                      <img src={hotel.image} alt={hotel.name} class="w-full h-full object-cover filter sepia-[.3] contrast-110 group-hover:scale-105 transition-transform duration-500" />
                    </a>
                  </div>
                )}
                <div class="w-full sm:w-3/5 p-6 flex flex-col justify-center">
                  <h3 class="font-anton text-2xl text-[#1a2b4c] uppercase tracking-wide mb-1">
                    <a href={hotel.venueSlug ? `/venues/${hotel.venueSlug}` : '#'} class="hover:text-[#c13a3a] transition-colors">{hotel.name}</a>
                  </h3>
                  {hotel.price && <p class="font-oswald uppercase tracking-widest text-[#d4b872] text-xs mb-3">{hotel.price}</p>}
                  {hotel.description && <p class="font-sans text-sm text-gray-700 mb-4 line-clamp-2">{hotel.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <Footer />
    </div>
  </div>
</BaseLayout>
