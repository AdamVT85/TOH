---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Section {
  heading?: string;
  venueSlug?: string;
  image?: string;
  imageAlt?: string;
  imageFocus?: string;
  caption?: string;
  copy?: string;
  callout?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  seriesLabel?: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImageFocus?: string;
  heroImageCredit?: string;
  publishDate?: string;
  excerpt?: string;
  watchList?: { title: string; year: string; image?: string }[];
  sections?: Section[];
  destinationTags?: string[];
}

const {
  title,
  subtitle,
  seriesLabel,
  heroImage,
  heroImageAlt,
  heroImageFocus,
  heroImageCredit,
  publishDate,
  excerpt,
  watchList = [],
  sections = [],
  destinationTags = [],
} = Astro.props;
---

<BaseLayout title={title} description={excerpt} image={heroImage} type="article">
  <div class="min-h-screen bg-[#fdfbf2] text-[#1a2b4c] p-2 md:p-8 font-sans" style="background-image: url('https://www.transparenttextures.com/patterns/aged-paper.png')">
    <div class="max-w-6xl mx-auto border-[12px] border-double border-[#1a2b4c] bg-[#fdfbf2] shadow-2xl relative overflow-hidden">

      <Header backLink="/" backLabel="Return to Lobby" variant="dark" />

      <!-- Hero Section -->
      <div class="relative w-full min-h-[60vh] md:min-h-[70vh] flex items-end overflow-hidden">
        {heroImage && (
          <img
            src={heroImage}
            alt={heroImageAlt || title}
            class="absolute inset-0 w-full h-full object-cover filter contrast-125 sepia-[.3]"
            style={`object-position: ${heroImageFocus || 'top'}`}
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4c] via-[#1a2b4c]/40 to-transparent opacity-90"></div>
        {heroImageCredit && (
          <span class="absolute bottom-2 right-3 z-20 font-typewriter text-[10px] text-[#fceeb5]/60">Photo: {heroImageCredit}</span>
        )}

        {seriesLabel && (
          <div class="absolute top-8 right-8 bg-[#c13a3a] text-[#fceeb5] font-oswald uppercase tracking-[0.2em] px-4 py-2 text-xs md:text-sm border-2 border-[#fceeb5] shadow-[4px_4px_0px_rgba(0,0,0,0.5)] transform rotate-2 z-20">
            {seriesLabel}
          </div>
        )}

        <div class="relative w-full p-6 pt-28 md:p-16 md:pt-36 text-center z-20">
          <h1 class="font-anton text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#fceeb5] tracking-wide uppercase text-3d transform -rotate-1 mb-4 leading-tight">
            {title}
          </h1>
        </div>
      </div>

      <!-- Content Area -->
      <div class="p-6 md:p-12 lg:p-16 max-w-6xl mx-auto">
        <div class="font-sans text-lg leading-relaxed text-[#222]">

          {subtitle && (
            <p class="text-xl md:text-2xl font-serif italic text-[#1a2b4c] leading-snug mb-12">
              {subtitle}
            </p>
          )}

          <!-- Sidebar (Floated Right on Desktop) -->
          {watchList.length > 0 && (
            <aside class="w-full lg:w-[340px] lg:float-right lg:ml-12 lg:mb-10 mb-12 space-y-12 clear-right">
              <div class="bg-[#1a2b4c] text-[#fceeb5] p-6 border-4 border-[#d4b872] shadow-[8px_8px_0px_#8b5a2b] transform rotate-1">
                <h3 class="font-anton text-3xl uppercase tracking-wider mb-2 text-center">The Watch List</h3>
                <p class="font-sans text-xs mb-6 text-center opacity-80 uppercase tracking-widest border-b border-[#d4b872] pb-4">Films to view before your departure</p>
                <div class="space-y-6">
                  {watchList.map((film) => (
                    <div class="flex gap-4 items-center group cursor-pointer">
                      {film.image && (
                        <div class="w-16 h-24 border-2 border-[#d4b872] overflow-hidden flex-shrink-0 bg-black">
                          <img src={film.image} alt={film.title} class="w-full h-full object-cover filter contrast-125 sepia-[.5] group-hover:scale-110 transition-transform" />
                        </div>
                      )}
                      <div>
                        <h4 class="font-oswald text-lg uppercase tracking-wider leading-tight group-hover:text-white transition-colors">{film.title}</h4>
                        <span class="font-typewriter text-xs opacity-70 block mb-2">{film.year}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </aside>
          )}

          <!-- Article Sections -->
          {sections.map((section, i) => (
            <div class="mb-12">
              {section.heading && (
                <h2 class="font-oswald text-3xl text-[#c13a3a] uppercase tracking-widest mb-4 border-b-2 border-dotted border-[#d4b872] pb-2">
                  {section.venueSlug ? (
                    <a href={`/venues/${section.venueSlug}`} class="hover:text-[#1a2b4c] transition-colors">{section.heading}</a>
                  ) : (
                    section.heading
                  )}
                </h2>
              )}

              {section.image && (
                <figure class={`my-6 p-2 bg-[#fdfbf2] border border-[#d4b872] shadow-[4px_4px_0px_rgba(212,184,114,0.4)] ${i % 2 === 0 ? 'transform -rotate-1' : 'transform rotate-1'} flow-root`}>
                  {section.venueSlug ? (
                    <a href={`/venues/${section.venueSlug}`}>
                      <img src={section.image} alt={section.imageAlt || section.heading} class="w-full h-64 md:h-96 object-cover filter contrast-125 sepia-[.3]" style={`object-position: ${section.imageFocus || 'center'}`} />
                    </a>
                  ) : (
                    <img src={section.image} alt={section.imageAlt || section.heading} class="w-full h-64 md:h-96 object-cover filter contrast-125 sepia-[.3]" style={`object-position: ${section.imageFocus || 'center'}`} />
                  )}
                  {section.caption && (
                    <figcaption class="text-center font-typewriter text-xs text-[#8b5a2b] mt-3 mb-1 uppercase tracking-widest">{section.caption}</figcaption>
                  )}
                </figure>
              )}

              {section.copy && section.copy.split('\n\n').map((para) => (
                <p class="mb-4" set:html={para} />
              ))}

              {section.callout && (
                <blockquote class="my-10 border-l-4 border-[#c13a3a] pl-6 py-4 bg-[#f4e4bc]/50 italic font-serif text-2xl text-[#8b5a2b] relative shadow-sm flow-root">
                  <span class="absolute -top-6 -left-4 font-anton text-8xl text-[#c13a3a] opacity-20">"</span>
                  {section.callout}
                </blockquote>
              )}
            </div>
          ))}

          <!-- Destination Tags -->
          {destinationTags.length > 0 && (
            <div class="mt-16 pt-8 border-t-4 border-double border-[#1a2b4c] clear-both">
              <h3 class="font-oswald uppercase tracking-widest text-[#1a2b4c] mb-6 text-xl">Destinations in this dispatch:</h3>
              <div class="flex flex-wrap gap-4">
                {destinationTags.map((tag) => (
                  <div class="relative bg-[#e8dcb8] border-2 border-[#8b5a2b] px-5 py-2 font-typewriter text-sm font-bold text-[#8b5a2b] uppercase tracking-widest shadow-[4px_4px_0px_rgba(139,90,43,0.3)] transform hover:-translate-y-1 transition-transform cursor-pointer">
                    <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 bg-[#fdfbf2] border-2 border-[#8b5a2b] rounded-full shadow-inner"></div>
                    <span class="ml-2">{tag}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Clear float -->
          <div class="clear-both"></div>
        </div>
      </div>

      <!-- You Might Also Like -->
      <div class="bg-[#1a2b4c] p-8 md:p-16 border-t-[12px] border-double border-[#d4b872]">
        <h3 class="font-anton text-4xl md:text-5xl text-[#fceeb5] tracking-widest uppercase text-center mb-12">You Might Also Like</h3>
        <slot name="related" />
      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>
