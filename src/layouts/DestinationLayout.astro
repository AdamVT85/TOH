---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Section {
  heading?: string;
  image?: string;
  imageAlt?: string;
  caption?: string;
  copy?: string;
  callout?: string;
}

interface Props {
  title: string;
  country?: string;
  region?: string;
  heroImage?: string;
  heroImageAlt?: string;
  excerpt?: string;
  passportStamps?: { city: string; detail?: string; date?: string }[];
  sections?: Section[];
}

const props = Astro.props;
const sections = props.sections || [];
---

<BaseLayout title={`Old Hollywood Guide to ${props.title}`} description={props.excerpt} image={props.heroImage || undefined} type="article">
  <div class="min-h-screen bg-[#d8c5a5] text-[#1a2b4c] p-2 md:p-8 font-sans" style="background-image: url('https://www.transparenttextures.com/patterns/aged-paper.png')">
    <div class="max-w-6xl mx-auto border-[12px] border-double border-[#1a2b4c] bg-[#fdfbf2] shadow-2xl relative overflow-hidden">

      <!-- Texture Overlays -->
      <div class="absolute inset-0 opacity-[0.03] mix-blend-multiply pointer-events-none z-50" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png')"></div>
      <div class="absolute inset-0 opacity-[0.02] mix-blend-color-burn pointer-events-none z-50" style="background-image: url('https://www.transparenttextures.com/patterns/diagmonds-light.png')"></div>

      <Header backLink="/" backLabel="Return to Lobby" variant="dark" />

      <!-- Hero Section -->
      <div class="relative w-full h-[60vh] min-h-[500px] overflow-hidden">
        {props.heroImage && (
          <img src={props.heroImage} alt={props.heroImageAlt || props.title} class="w-full h-full object-cover filter contrast-125 sepia-[.3]" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4c] via-[#1a2b4c]/40 to-transparent opacity-90"></div>

        <!-- Passport Stamps -->
        {props.passportStamps && props.passportStamps.length > 0 && (
          <div class="absolute top-12 right-12 z-20 transform rotate-12 opacity-80">
            <div class="w-32 h-32 rounded-full border-4 border-double border-[#c13a3a] flex items-center justify-center relative">
              <div class="absolute inset-2 rounded-full border border-[#c13a3a] border-dashed"></div>
              <div class="text-center text-[#c13a3a] font-typewriter">
                <p class="text-sm font-bold tracking-widest">{props.passportStamps[0].city}</p>
                {props.passportStamps[0].detail && <p class="text-[10px] tracking-wider">{props.passportStamps[0].detail}</p>}
                {props.passportStamps[0].date && <p class="text-xs font-bold mt-1">{props.passportStamps[0].date}</p>}
              </div>
            </div>
          </div>
        )}

        <div class="absolute bottom-0 left-0 w-full p-6 md:p-16 text-center z-20 flex flex-col items-center">
          <h1 class="font-anton text-6xl md:text-8xl lg:text-9xl text-[#fceeb5] tracking-wide uppercase text-3d transform -rotate-2 mb-2 leading-none">
            {props.country || props.title}
          </h1>
          {props.region && (
            <p class="font-cursive text-4xl md:text-6xl text-[#fdfbf2] transform -rotate-2" style="text-shadow: 2px 2px 0px #1a2b4c; -webkit-text-stroke: 1px #1a2b4c">
              {props.region}
            </p>
          )}
        </div>
      </div>

      <!-- Body Content -->
      <div class="p-6 md:p-12 lg:p-16 relative">
        <div class="max-w-5xl mx-auto relative">
          <div class="font-sans text-lg leading-relaxed text-[#222]">
            {sections.map((section, i) => (
              <div class="mb-12">
                {section.heading && (
                  <h2 class="font-anton text-4xl md:text-5xl text-[#1a2b4c] uppercase tracking-widest mb-12 text-center border-b-4 border-double border-[#1a2b4c] pb-4">
                    {section.heading}
                  </h2>
                )}

                {section.image && (
                  <figure class={`my-6 p-2 bg-[#fdfbf2] border border-[#d4b872] shadow-[4px_4px_0px_rgba(212,184,114,0.4)] ${i % 2 === 0 ? 'transform -rotate-1' : 'transform rotate-1'} flow-root`}>
                    <img src={section.image} alt={section.imageAlt || section.heading} class="w-full h-64 md:h-96 object-cover filter contrast-125 sepia-[.3]" />
                    {section.caption && (
                      <figcaption class="text-center font-typewriter text-xs text-[#8b5a2b] mt-3 mb-1 uppercase tracking-widest">{section.caption}</figcaption>
                    )}
                  </figure>
                )}

                {section.copy && section.copy.split('\n\n').map((para) => (
                  <p class="mb-4" set:html={para} />
                ))}

                {section.callout && (
                  <blockquote class="my-10 border-l-4 border-[#c13a3a] pl-6 py-4 bg-[#f4e4bc]/50 italic font-serif text-2xl text-[#8b5a2b] relative shadow-sm flow-root">
                    <span class="absolute -top-6 -left-4 font-anton text-8xl text-[#c13a3a] opacity-20">"</span>
                    {section.callout}
                  </blockquote>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- You Might Also Like -->
      <div class="bg-[#1a2b4c] p-8 md:p-16 border-t-[12px] border-double border-[#d4b872]">
        <h3 class="font-anton text-4xl md:text-5xl text-[#fceeb5] tracking-widest uppercase text-center mb-12">Explore Further</h3>
        <slot name="related" />
      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>
