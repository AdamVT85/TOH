---
const year = new Date().getFullYear();
---

<footer class="bg-[#151515] text-[#d4b872] border-t-[6px] border-[#0a0a0a] relative z-30">
  <div class="px-4 md:px-6 py-3 md:py-4 flex flex-col md:flex-row justify-between items-center gap-4 md:gap-0">
    <div class="flex space-x-4 md:space-x-6 items-center">
      <div class="border-2 border-[#d4b872] p-1 px-2 text-xs md:text-sm font-anton tracking-widest transform -skew-x-12">CB</div>
      <div class="text-[10px] md:text-xs font-oswald tracking-[0.2em] flex flex-col items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 md:w-6 md:h-6 mb-0.5"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
        PAN-AM
      </div>
      <div class="text-[8px] md:text-[10px] font-sans tracking-widest border-l border-r border-[#d4b872] px-2 md:px-4 opacity-70">
        Away With Words
      </div>
    </div>

    <a href="/" class="text-center font-anton tracking-widest text-xl md:text-3xl text-[#d4b872] leading-none hover:text-white transition-colors">
      <span class="block text-[8px] md:text-[10px] font-sans tracking-[0.3em] mb-1 opacity-80">TRAVEL</span>OLD HOLLYWOOD
    </a>

    <div class="flex items-center space-x-4 md:space-x-6">
      <a href="/directory" class="text-[10px] md:text-xs font-oswald uppercase tracking-[0.2em] hidden lg:inline hover:text-white cursor-pointer transition-colors">Index</a>
      <a href="/" class="border-2 border-[#d4b872] px-4 md:px-6 py-1.5 md:py-2 font-oswald text-xs md:text-sm tracking-[0.2em] hover:bg-[#d4b872] hover:text-[#151515] transition-colors uppercase">
        Book Passage
      </a>
    </div>
  </div>

  <div class="border-t border-[#d4b872]/20 px-4 md:px-6 py-2.5 flex flex-col sm:flex-row justify-center items-center gap-x-5 gap-y-1 text-center">
    <span class="font-typewriter text-[10px] text-[#d4b872]/50">© {year} Travel Old Hollywood</span>
    <span class="hidden sm:inline text-[#d4b872]/20" aria-hidden="true">&middot;</span>
    <a href="/privacy" class="font-oswald text-[10px] uppercase tracking-[0.2em] text-[#d4b872]/70 hover:text-white transition-colors">Privacy</a>
    <span class="hidden sm:inline text-[#d4b872]/20" aria-hidden="true">&middot;</span>
    <a href="/affiliate-disclosure" class="font-oswald text-[10px] uppercase tracking-[0.2em] text-[#d4b872]/70 hover:text-white transition-colors">Affiliate Disclosure</a>
  </div>
</footer>
